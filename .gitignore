# ---- 本地运行数据（对应 01 §1 的 /data/ekbs，开发机落在 var/）----
var/
# 云端联调用的第二份数据目录（config/application.cloud.yaml）。
# 必须整体忽略：日志文件名不一定带 .log（手工起服务时是 api*.out），
# 只按扩展名忽略会让它们漏进版本库。
var-cloud/
*.db
*.db-wal
*.db-shm
*.faiss
*.log

# ---- 密钥（01 §0.2 / 04 §2.6：绝不入库）----
secrets.env
.env
*.pem
# 双机热备节点配置：文件头约定「含内网拓扑，同样不入 git」，模板留本地
deploy/config/node.env.example

# ---- macOS ----
.DS_Store

# ---- 甲方方案文档（独立交付物，不入代码库；如需私有库保留，删掉这一段即可）----
方案/
# ---- 一次性的交付报表与 Excel 临时文件 ----
# 维护/交接文档（独立交付物，不入代码库；要在仓库里保留就删掉这两行）
RAG维护文档/
# ---- 三份独立交付物（不入代码库，本地保留）----
EKBS方案评估报告-*.md
RAG企业知识库使用说明.docx
正式方案-v4/

# 管理台前端（ekbs-admin-web）：依赖与构建产物都不入库
ekbs-admin-web/node_modules/
ekbs-admin-web/dist/
ekbs-admin-web/.vite/

# 根目录误装的前端依赖
node_modules/
:memory:.ses
