<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.ekbs.api —— EKBS 问答 API（FastAPI + Uvicorn）
  来源：01-实施步骤与本地部署.md §8.1（逐字模板）+ §8.2 服务清单；端口与 workers 口径见 04 §7.1。
  安装：cp 本文件到 ~/Library/LaunchAgents/ 后 `launchctl load -w`（见 deploy/scripts/install.sh）。
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.ekbs.api</string>

  <!-- 通过 zsh 包装以注入密钥；launchd 不会读 shell profile，必须显式 source。
       凭据注入纪律见 01 §8.1 与 04 §2.6：密钥只出现在 secrets.env，绝不出现在本 plist 里。
       若 ~/.zshrc 含交互式语句，把下面的 -lc 改为 -c（不带 -l）以避免副作用（01 §8.1 注）。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>set -a; source "$HOME/.ekbs/secrets.env"; set +a; exec /opt/ekbs/venv/bin/uvicorn ekbs.main:app --host 127.0.0.1 --port 8000 --workers 1 --timeout-keep-alive 75</string>
  </array>

  <!-- 代码目录是 release 符号链接 /opt/ekbs/app -> /opt/ekbs/releases/<时间戳>（04 §7.6） -->
  <key>WorkingDirectory</key><string>/opt/ekbs/app</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>EKBS_CONFIG</key><string>/opt/ekbs/etc/application.yaml</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>

  <key>StandardOutPath</key><string>/opt/ekbs/log/api.out.log</string>
  <key>StandardErrorPath</key><string>/opt/ekbs/log/api.err.log</string>

  <key>RunAtLoad</key><true/>

  <!-- api/worker/scheduler 用 SuccessfulExit=false：仅「异常退出/被信号杀死」时拉起。
       主动 `launchctl stop`（退出码 0）不会被重启，便于人工维护窗口。
       注：01 §8.2 的汇总表把 worker/scheduler 的 KeepAlive 简写为 true，
       本目录以 01 §8.1 的 plist 模板为准（见交付说明的矛盾清单）。 -->
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>

  <!-- 崩溃后最小重启间隔 10s，避免「启动即崩」时疯狂拉起（04 §7.3 健康检查表同口径） -->
  <key>ThrottleInterval</key><integer>10</integer>

  <!-- 在线问答进程：对延迟敏感，按 01 §8.1 原文使用 Interactive -->
  <key>ProcessType</key><string>Interactive</string>
</dict></plist>
