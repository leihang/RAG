<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.ekbs.worker —— 解析 worker（MinerU 串行）
  来源：01 §8.1 模板 + §8.2 服务清单；04 §7.1 服务清单（入口 `python -m ekbs.worker`）。
  解析严格串行（parse.worker_concurrency: 1），避免 MinerU 在 16 GB 机器上内存峰值叠加。
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.ekbs.worker</string>

  <!-- worker 解析期可能间接调用云端嵌入（入库流水线），因此同样需要 secrets.env -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>set -a; source "$HOME/.ekbs/secrets.env"; set +a; exec /opt/ekbs/venv/bin/python -m ekbs.worker</string>
  </array>

  <key>WorkingDirectory</key><string>/opt/ekbs/app</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>EKBS_CONFIG</key><string>/opt/ekbs/etc/application.yaml</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>

  <key>StandardOutPath</key><string>/opt/ekbs/log/worker.out.log</string>
  <key>StandardErrorPath</key><string>/opt/ekbs/log/worker.err.log</string>

  <key>RunAtLoad</key><true/>

  <!-- 与 api 同口径：仅异常退出才拉起，人工 stop 后不自动回来。
       注：01 §8.2 汇总表把本项简写为 true，本目录以 01 §8.1 的 plist 模板为准。 -->
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>

  <key>ThrottleInterval</key><integer>10</integer>

  <!-- 长耗时 CPU/IO 任务：用 Background 让系统优先保障 api 与 dingtalk 的交互延迟。
       （01 §8.1 只对 api 指定 Interactive；此处按用途补齐，见交付说明。） -->
  <key>ProcessType</key><string>Background</string>
</dict></plist>
