<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.ekbs.dingtalk —— 钉钉 Stream 适配器（长连接 + H5 免登小 HTTP 实例）
  来源：04-钉钉接入方案.md §7.1.1（在 01 §8.1 模板上的差异项）、§7.1 服务清单、§7.5 唯一连接约束。
  入口是 `python -m ekbs.stream`（不是 uvicorn）：该模块内部既启动 DingTalkStreamClient，
  也启动一个只监听 127.0.0.1:8100 的 FastAPI 实例。
  ⚠️ 01 §8.2 汇总表把入口写成 `ekbs.dingtalk.stream`，与 04（§5.1 包结构、§7.1、§7.1.1、
  §7.4 的 pkill 串）不一致；本目录以 04 的 `python -m ekbs.stream` 为准（见交付说明的矛盾清单）。
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.ekbs.dingtalk</string>

  <!-- 密钥注入方式与 api 完全一致。
       适配器需要的是「钉钉应用凭据」与「内部回环 Token」两类密钥，键名见 secrets.env，
       此处刻意不写键名 —— deploy/scripts/check-secrets.sh 会对 plist 做密钥名断言，
       在注释里写出键名会被判为「plist 中出现密钥明文」而失败。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>set -a; source "$HOME/.ekbs/secrets.env"; set +a; exec /opt/ekbs/venv/bin/python -m ekbs.stream</string>
  </array>

  <key>WorkingDirectory</key><string>/opt/ekbs/app</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>EKBS_CONFIG</key><string>/opt/ekbs/etc/application.yaml</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>

  <!-- 日志文件独立：Stream 的高频心跳日志不应淹没 API 日志（04 §7.1.1 差异项 ②③） -->
  <key>StandardOutPath</key><string>/opt/ekbs/log/dingtalk.out.log</string>
  <key>StandardErrorPath</key><string>/opt/ekbs/log/dingtalk.err.log</string>

  <key>RunAtLoad</key><true/>

  <!-- 必须为 true（04 §7.1.1 差异项 ④）：Stream 断开期间钉钉不会重投消息，
       所以任何退出（含退出码 0）都必须被拉起。
       ⚠️ 04 §7.4 的优雅退出表写「KeepAlive 配的是 SuccessfulExit=false，因此不会被重启」，
       与本条冲突；此处按 04 §7.1.1 的显式要求设为 true（见交付说明的矛盾清单）。 -->
  <key>KeepAlive</key><true/>

  <key>ThrottleInterval</key><integer>10</integer>

  <!-- 实时收发消息、卡片流式更新，对延迟敏感。
       注：01 §8.1 只对 api 指定了 Interactive，其余三个服务的 ProcessType 由本目录按用途补齐
       （dingtalk=Interactive；worker/scheduler=Background），不构成与文档的冲突。 -->
  <key>ProcessType</key><string>Interactive</string>
</dict></plist>
