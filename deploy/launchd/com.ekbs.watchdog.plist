<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.ekbs.watchdog.plist —— 备机看门狗（00 v4.0 D14、08 §1.1）
  安装位置：**备机** ~/Library/LaunchAgents/
  行为：每 60s 探测主机 /readyz；连续 3 次失败 → 告警（钉钉/邮件/审计），
        **不自动切换**（切换须人工执行 deploy/scripts/failover.sh）。
  与 ekbs 服务的区别：它只是探测与告警，不写入业务库（除 security_event）。
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.ekbs.watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>set -a; [ -f "$HOME/.ekbs/secrets.env" ] && source "$HOME/.ekbs/secrets.env"; set +a; exec /opt/ekbs/etc/watchdog.sh</string>
  </array>

  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>

  <key>StandardOutPath</key><string>/opt/ekbs/log/watchdog.out.log</string>
  <key>StandardErrorPath</key><string>/opt/ekbs/log/watchdog.err.log</string>
</dict></plist>
