<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.ekbs.scheduler —— APScheduler 单实例调度器
  来源：01 §8.1 模板 + §8.2 服务清单（含「为什么调度器要独立成进程」的三条理由）；
        作业注册表见 04 §7.1.4（8 个作业：组织同步、对账、权限兜底、缓存清理、指标采集）。
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.ekbs.scheduler</string>

  <!-- 组织同步会调用钉钉 OpenAPI，需要 secrets.env -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>set -a; source "$HOME/.ekbs/secrets.env"; set +a; exec /opt/ekbs/venv/bin/python -m ekbs.scheduler</string>
  </array>

  <key>WorkingDirectory</key><string>/opt/ekbs/app</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>EKBS_CONFIG</key><string>/opt/ekbs/etc/application.yaml</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>

  <key>StandardOutPath</key><string>/opt/ekbs/log/scheduler.out.log</string>
  <key>StandardErrorPath</key><string>/opt/ekbs/log/scheduler.err.log</string>

  <key>RunAtLoad</key><true/>

  <!-- 与 api 同口径：仅异常退出才拉起。
       作业级并发另由 ekbs_cache 的 set_nx 短租约锁兜底（01 §8.2、04 §7.1.4）。 -->
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>

  <key>ThrottleInterval</key><integer>10</integer>

  <!-- 定时作业（含每 60s 的 collect_metrics）：后台低优先级，不与在线问答争 CPU。
       （01 §8.1 只对 api 指定 Interactive；此处按用途补齐，见交付说明。） -->
  <key>ProcessType</key><string>Background</string>
</dict></plist>
