# =============================================================================
# EKBS 敏感凭据模板 —— 复制为 ~/.ekbs/secrets.env
# -----------------------------------------------------------------------------
# 【使用方式】
#   mkdir -p ~/.ekbs && cp deploy/config/secrets.env.example ~/.ekbs/secrets.env
#   chmod 700 ~/.ekbs
#   chmod 600 ~/.ekbs/secrets.env      # 必须恰为 600，install.sh 与 check-secrets.sh 都会断言
#   然后填入真实值：把全部 CHANGE_ME_* 占位值替换掉。
#   （占位值故意写成 shell 合法字面量 —— 未替换时 `source` 不会报错，只会在鉴权时失败。）
#
#   为什么必须 600：launchd 不读 shell profile，密钥只能靠
#   `zsh -lc 'set -a; source "$HOME/.ekbs/secrets.env"; set +a; exec …'` 注入进程环境
#   （plist 见 deploy/launchd/*.plist）。该文件是全栈唯一凭据来源，权限过宽 = 全量凭据泄露。
#
# 【三条硬纪律】（04 §2.6，强制，不是建议）
#   ① 本文件权限 600、属主为运行 launchd 的那个用户；由脚本断言，不靠人工 chmod；
#   ② **绝不写进 plist 的 EnvironmentVariables**，也绝不写进 application.yaml；
#   ③ `.gitignore` 必须包含 `.ekbs/`，并由 deploy/scripts/check-secrets.sh 断言「未被 git 跟踪」。
#      一旦发现曾被提交：立即 `git rm --cached` 并轮换其中**全部**密钥（历史里删不掉）。
#
# 【轮换周期速查】DINGTALK_CLIENT_SECRET 90 天 ｜ DASHSCOPE / DEEPSEEK 90 天 ｜
#                  EKBS_JWT_SECRET / EKBS_INTERNAL_TOKEN 180 天
#   轮换后：改本文件 → 按 api → scheduler → worker → dingtalk 顺序重启（deploy/scripts/release.sh 的重启循环）。
#   EKBS_JWT_SECRET 支持双密钥滚动：先加 *_PREVIOUS，等旧 token 过期（≤ token TTL）后再删除。
# =============================================================================

# ---- 云端模型（出网白名单见 01 §11）----

# 阿里云百炼：云端嵌入（text-embedding-v4）、rerank（gte-rerank-v2）、LLM（qwen-max）
# 使用方：ekbs-api。入库与检索都会调用 —— 缺失即「全站不可问答」，不做降级（00 §2.3）
# 轮换周期：90 天
DASHSCOPE_API_KEY=CHANGE_ME_sk_dashscope

# DeepSeek：仅作 LLM 兜底通道（models.llm.fallback，见 application.yaml）
# 使用方：ekbs-api。可留空 —— 留空表示不启用兜底，主模型故障时问答直接失败
# 轮换周期：90 天
DEEPSEEK_API_KEY=CHANGE_ME_sk_deepseek

# ---- 钉钉（应用凭证，04 §2.6）----

# = AppKey。企业内部应用的唯一标识
# 使用方：com.ekbs.dingtalk（Stream 连接与 OpenAPI 取 token）
# 轮换周期：变更应用时（AppKey 本身不可轮换，换应用即换 Key）
DINGTALK_CLIENT_ID=CHANGE_ME_dingtalk_appkey

# AppSecret。换取 access_token 的凭据，泄露 = 可冒充应用收发消息
# 使用方：com.ekbs.dingtalk
# 轮换周期：90 天（钉钉后台重置后立即更新本文件并重启 dingtalk）
DINGTALK_CLIENT_SECRET=CHANGE_ME_dingtalk_appsecret

# 机器人编码。卡片/机器人消息接口的 robotCode 参数
# 使用方：com.ekbs.dingtalk
# 轮换周期：变更机器人时
# ⚠️ 口径冲突：04 §2.6 把它归入「非敏感」（写在 application.yaml），
#    而 01 §7 的 secrets.env 示例把它列为敏感项。本模板按 01 §7 保留在此，
#    同时在 application.yaml 的 dingtalk.robot_code / dingtalk.openapi.robot_code 留了同值占位。
#    落地前必须二选一，不要两处都填真值（见交付说明的矛盾清单）。
DINGTALK_ROBOT_CODE=CHANGE_ME_dingtalk_robotcode

# 企业 CorpId。免登（H5 微应用）与部分组织接口需要
# 使用方：com.ekbs.dingtalk、ekbs-api（免登校验）
# 轮换周期：变更企业时
# ⚠️ 口径冲突：同 DINGTALK_ROBOT_CODE —— 04 §2.6 视为非敏感，01 §7 放在 secrets.env。
DINGTALK_CORP_ID=CHANGE_ME_dingtalk_corpid

# ---- 内部凭据（EKBS 自签，不来自第三方）----

# JWT 签名密钥。签发给 H5 / 管理台的会话 token
# 使用方：ekbs-api（签发与校验）、com.ekbs.dingtalk（校验免登回传）
# 轮换周期：180 天（支持双密钥滚动）
# 生成：openssl rand -base64 48
# ⚠️ 命名冲突：01 §7 的示例写作 `JWT_SECRET`，04 §2.6 与 check-secrets.sh 用 `EKBS_JWT_SECRET`。
#    本模板采用 04 的 `EKBS_JWT_SECRET`（代码侧读的是这个）。改名后请同步更新 01 §7（本次未改动任何 .md）。
EKBS_JWT_SECRET=CHANGE_ME_run_openssl_rand_base64_48

# 内部回环 Token。com.ekbs.dingtalk → ekbs-api（127.0.0.1:8000）的回环调用凭据
# 使用方：com.ekbs.dingtalk 发起、ekbs-api 校验。仅本机使用，不对外暴露
# 轮换周期：180 天
# 生成：openssl rand -hex 32
# ⚠️ 该键在 01 §7 的示例中缺失，仅见 04 §2.6 的 SECRET_FIELDS 清单。
EKBS_INTERNAL_TOKEN=CHANGE_ME_run_openssl_rand_hex_32

# =============================================================================
# 告警通道（08 §5.2）—— 全部可选；不配置则该通道停用（只记日志）
# -----------------------------------------------------------------------------
# 主通道：钉钉自定义群机器人 webhook（含加签密钥，机器人开启加签时必填）。
# 带外通道：SMTP 邮件。**必须配置**——故障恰是钉钉出网中断时，主通道同时失效，
#           邮件是 P0/P1 的保底（08 §5.2；通道心跳每日 09:00 验证可达性）。
# =============================================================================
EKBS_ALERT_DINGTALK_WEBHOOK=CHANGE_ME_https://oapi.dingtalk.com/robot/send?access_token=xxx
EKBS_ALERT_DINGTALK_SECRET=CHANGE_ME_SEC_xxx

EKBS_ALERT_SMTP_HOST=CHANGE_ME_smtp.company.com
EKBS_ALERT_SMTP_PORT=465
EKBS_ALERT_SMTP_USER=CHANGE_ME_kb-alert@company.com
EKBS_ALERT_SMTP_PASSWORD=CHANGE_ME_smtp_auth_code
EKBS_ALERT_SMTP_FROM=CHANGE_ME_kb-alert@company.com
EKBS_ALERT_SMTP_TO=CHANGE_ME_ops@company.com,chANGE_ME_sec@company.com
